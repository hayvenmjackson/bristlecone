<?xml version="1.0" encoding="utf-8"?>
<!-- Hikes, places and settings never go to Google's cloud backup. The in-app backup
     (a .zip the user saves wherever they choose) is the only way data leaves the phone.
     Moving to a new phone by cable or direct Wi-Fi transfer is still allowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
